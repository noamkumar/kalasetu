# =====================================================================
# KalaSetu Backend Environment Configuration (.env.example)
# Bridging Artisans to the World with AI
# =====================================================================

# Server & Runtime
APP_ENV=development                       # development | production | test
API_BASE_PATH=/api/v1
HOST=0.0.0.0
PORT=8000

# Demo Mode
DEMO_MODE=false                           # true enables 3 demo artisans, 2 demo buyers & fixed OTP 123456

# Database Persistence
# Local Development: SQLite
DATABASE_URL=sqlite:///./kalasetu.db
# Hosted Production: PostgreSQL (Render, Supabase, Neon)
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/kalasetu

# Object Storage (StorageProvider interface)
# Local Development: local filesystem
STORAGE_BACKEND=local                     # local | s3 | supabase
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET=kalasetu-storage
VOICE_CACHE_PATH=./uploads/voice_cache

# Cloud Storage (AWS S3, Supabase Storage S3-compatible, Cloudflare R2)
# STORAGE_BACKEND=s3
# STORAGE_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
# STORAGE_ACCESS_KEY=your_storage_access_key
# STORAGE_SECRET_KEY=your_storage_secret_key
# STORAGE_REGION=us-east-1
# STORAGE_PUBLIC_URL_BASE=https://<project-ref>.supabase.co/storage/v1/object/public/kalasetu-storage

# AI Provider Configuration (mock | real)
AI_MODE=real                              # mock (no API key needed) | real (Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
REQUEST_TIMEOUT_SECONDS=60
STT_PROVIDER=gemini
IMAGE_EDIT_PROVIDER=local
ENABLE_LOCAL_FALLBACK=false

# Gemini Cost & Quota Protection (Daily Caps)
GEMINI_DAILY_USER_CAP=50                  # Max daily AI operations per registered artisan/user
GEMINI_DAILY_IP_CAP=100                   # Max daily AI operations per client IP address
GEMINI_DAILY_DEMO_CAP=15                  # Max daily AI operations for demo accounts

# Authentication & Security
# WARNING: JWT_SECRET MUST be set to a secure, random string in production (APP_ENV=production)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_PROVIDER_KEY=                         # Optional external SMS gateway key

# CORS Settings (comma-separated origins or * for all)
ALLOWED_ORIGINS=*
